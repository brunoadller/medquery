# Copie para .env e preencha. NUNCA suba o .env para o Git.

PORT=3000

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Access token curto + refresh token longo (rotativo)
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Transcrição do áudio (OpenAI)
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Geração do relatório (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Onde ficam o banco e os áudios (em produção: volume criptografado)
DATA_DIR=./data

# Atrás de proxy/Nginx/Render/Railway use 1; local use 0
TRUST_PROXY=0
